[Unit]
Description=Agentic-OS Scheduler API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/agentic-os
Environment=PYTHONPATH=/opt/agentic-os
ExecStart=/opt/agentic-os/venv/bin/uvicorn app:app --app-dir /opt/agentic-os/scheduler --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
