[Unit]
Description=Agentic-OS Gateway API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/agentic-os
Environment=PYTHONPATH=/opt/agentic-os
EnvironmentFile=-/etc/agentic-os/env
ExecStart=/opt/agentic-os/venv/bin/uvicorn app:app --app-dir /opt/agentic-os/gateway --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
