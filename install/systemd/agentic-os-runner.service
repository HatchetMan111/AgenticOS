[Unit]
Description=Agentic-OS Runner Worker
After=network-online.target agentic-os-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/agentic-os
Environment=PYTHONPATH=/opt/agentic-os
ExecStart=/opt/agentic-os/venv/bin/python -m runner.worker_daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
